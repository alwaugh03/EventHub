
<h1 class="mb-4">Profile</h1>
<div class="mb-3">
<h3><%= current_user.first_name %> <%= current_user.last_name %></h3>
<h5 class="text-muted"><%= current_user.email %></h5>
</div>

<div>
<%= button_to "Edit Profile", edit_user_registration_path,
    method: :get,
    class: "btn btn-primary" %>

<%= button_to "Log out", destroy_user_session_path, 
    method: :delete,
    class: "btn btn-warning" %>
  
<%= button_to "Delete Profile", user_registration_path, 
    method: :delete,
    class: "btn btn-danger" %> 
</div>
  