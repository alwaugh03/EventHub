<!-- HERO SECTION -->
<section class="bg-light text-center py-5">
  <div class="container">
    <h1 class="display-4 fw-bold">Discover Events Near You</h1>
    <p class="lead">
      EventHub connects you with the best events happening around you—from concerts to tech meetups.
    </p>
    <%= link_to "Browse Events", "#", class: "btn btn-primary btn-lg mt-3" %>
  </div>
</section>

<!-- ABOUT SECTION -->
<section class="py-5">
  <div class="container">
    <div class="row align-items-center">
      
      <div class="col-md-6">
        <h2>About EventHub</h2>
        <p>
          EventHub helps users discover, explore, and join events tailored to their interests.
          From entertainment to networking and learning opportunities, everything is in one place.
        </p>
        <p>
          Built for students, professionals, and communities looking to stay connected.
        </p>
      </div>

      <div class="col-md-6">
        <%= image_tag "https://via.placeholder.com/500x300", class: "img-fluid rounded" %>
      </div>

    </div>
  </div>
</section>

<!-- CONTACT SECTION -->
<section class="bg-light py-5">
  <div class="container text-center">
    <h2>Contact Us</h2>
    <p class="mb-1">Email: contact@eventhub.com</p>
    <p class="mb-1">Phone: +1 234 567 890</p>
    <p>Address: 123 Main Street, Your City</p>
  </div>
</section>