<div class="container mt-4">

  <div class="card">

    <div class="card-body">

      <h1 class="card-title mb-3">
        <%= @category.name %>
      </h1>

      <p class="card-text">
        <%= @category.description %>
      </p>

    </div>

    <div class="card-footer d-flex gap-2">

      <% if can? :update, @category %>
        <%= link_to "Edit",
                    edit_category_path(@category),
                    class: "btn btn-primary" %>
      <% end %>
      <%= link_to "Back",
                  categories_path,
                  class: "btn btn-secondary" %>

    </div>

  </div>

</div>