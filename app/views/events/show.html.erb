<h1><%= @event.title %></h1>

<p><%= @event.description %></p>

<p><strong>Category:</strong> <%= @event.category %></p>
<p><strong>Venue:</strong> <%= @event.venue %></p>

<p>
  <strong>Dates:</strong>
  <%= @event.start_date %> - <%= @event.end_date %>
</p>

<p><strong>Status:</strong> <%= @event.lifecycle_stage %></p>

<p>
  <strong>Capacity:</strong>
  <%= @event.available_capacity %> /
  <%= @event.maximum_capacity %>
</p>

<p>
  <strong>Organizer:</strong>
  <%= @event.organizer.email %>
</p>

<hr>

<h3>Registrations</h3>
<ul>
  <% @event.registrations.each do |registration| %>
    <li>
      <%= registration.user.email %> - <%= registration.status %>
    </li>
  <% end %>
</ul>

<hr>

<h3>Reviews</h3>
<div class="d-flex justify-content-between align-items-center mb-4">
    <%= link_to "New Review", new_review_path, class: "btn btn-primary" %>
</div>
<ul>
  <% @event.reviews.each do |review| %>
    <li>
      <%= review.comment %> - <%= review.rating %>
    </li>
    <%= link_to "Edit", edit_review_path(review), class: "btn btn-sm btn-warning" %>
  <% end %>

</ul>

<div class="btn-group" role="group">
  <%= link_to "Edit", edit_event_path(@event), class: "btn btn-sm btn-warning" %>
  <%= link_to "Delete", event_path(@event), 
                method: :delete, 
                data: { turbo_confirm: "Are you sure?" }, 
                class: "btn btn-sm btn-danger" %>
</div>
