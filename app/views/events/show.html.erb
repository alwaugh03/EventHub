<h1><%= @event.title %></h1>

<p><%= @event.description %></p>

<p><strong>Category:</strong> <%= @event.category.name %></p>
<p><strong>Venue:</strong> <%= @event.venue.name %></p>

<p>
  <strong>Dates:</strong>
  <%= @event.start_date %> - <%= @event.end_date %>
</p>

<p><strong>Status:</strong> <%= @event.lifecycle_stage %></p>

<p>
  <strong>Capacity:</strong>
  <%= @event.available_capacity %> /
  <%= @event.maximum_capacity %>
</p>

<p>
  <strong>Organizer:</strong>
  <%= @event.organizer.email %>
</p>

<hr>

<h3>Registrations</h3>
  <% if @event.lifecycle_stage == :published %>
    <%= link_to "Register", new_event_event_registration_path(@event), class: "btn btn-primary" %>
  <% end %>
<ul>
  <% @event.registrations.each do |registration| %>
    <li>
      <%= registration.user.email %> - <%= registration.status %>
      <% if can? :destroy, registration %>
        <%= button_to "Cancel", event_event_registration_path(@event, registration), 
                      method: :delete, 
                      data: { turbo: false, confirm: "Are you sure?" },
                      class: "btn btn-sm btn-danger ms-2" %>
      <% end %>
    </li>
    
  <% end %>
</ul>

<hr>

<h3>Reviews</h3>
<div class="d-flex justify-content-between align-items-center mb-4">
    <% if @event.lifecycle_stage == "completed" %>
      <%= link_to "New Review", new_event_review_path(@event), class: "btn btn-primary" %>
    <% end %>
</div>
<ul>
  <% @event.reviews.each do |review| %>
    <li>
      <%= review.comment %> - <%= review.rating %>
    </li>
    <div>
    <% if can? :destroy, review %>
      <%= button_to "Delete", review_path(review), 
                  method: :delete, 
                  data: { turbo: false },
                  class: "btn btn-sm btn-danger",
                  form_class: "d-inline-block" %>
    <% end %>
    </div>
  <% end %>

</ul>

<div>
<h3>Event</h3>
  <% if can? :update, @event %>
    <%= link_to "Edit", edit_event_path(@event), class: "btn btn-sm btn-warning me-2" %>
  <% end %>

  <% if can? :destroy, @event %>
    <%= button_to "Delete", @event, 
                  method: :delete, 
                  data: { turbo: false },
                  class: "btn btn-sm btn-danger",
                  form_class: "d-inline-block" %>
  <% end %>
</div>
