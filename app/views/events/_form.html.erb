<%= form_with(model: event, local: true, data: { turbo: false }) do |f| %>
    <div class="mb-3">
        <%= f.label :title, class: 'form-label' %>
        <%= f.text_field :title, class: 'form-control' %>
    </div>

<div class="mb-3">
    <%= f.label :category_id, "Category", class: 'form-label' %>

    <%= f.collection_select :category_id,Category.all,:id,:name,{ prompt: "Select a category" },{ class: 'form-select' } %>
</div>

<div class="mb-3">
    <%= f.label :venue_id, "Venue", class: 'form-label' %>

    <%= f.collection_select :venue_id,Venue.all,:id,:name,{ prompt: "Select a venue" },{ class: 'form-select' } %>
</div>

<div class="mb-3">
    <%= f.label :maximum_capacity, class: 'form-label' %>
    <%= f.number_field :maximum_capacity, class: 'form-control' %>
</div>

    <div class="mb-3">
        <%= f.label :start_date, class: 'form-label' %>
        <%= f.datetime_local_field :start_date, class: 'form-control' %>
    </div>

    <div class="mb-3">
        <%= f.label :end_date, class: 'form-label' %>
        <%= f.datetime_local_field :end_date, class: 'form-control' %>
    </div>

    <div class="mb-3">
        <%= f.label :description, class: 'form-label' %>
        <%= f.rich_text_area :description, class: 'form-control', rows: 5 %>
    </div>

    <div class="mb-3">
        <%= f.submit class: 'btn btn-primary' %>
    </div>
<% end %>