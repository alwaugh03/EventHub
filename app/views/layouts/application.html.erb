<head>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/trix@2.0.8/dist/trix.css">
  
  <%= stylesheet_link_tag 'actiontext' %>
  
  <%= stylesheet_link_tag 'application', media: 'all' %>
  
  <%= javascript_include_tag "application", defer: true %>
  
</head>

<body>

  <!-- NAVBAR -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <%= link_to "EventHub", root_path, class: "navbar-brand" %>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNav">
  <ul class="navbar-nav ms-auto">
    <li class="nav-item">
      <%= link_to "Events", events_path, class: "nav-link" %>
    </li>

    <li class="nav-item">
      <%= link_to "Categories", categories_path, class: "nav-link" %>
    </li>

    <li class="nav-item">
      <%= link_to "Venues", venues_path, class: "nav-link" %>
    </li>

    <li class="nav-item">
      <%= link_to "Login", new_user_session_path, class: "nav-link" %>
    </li>

    <li class="nav-item">
      <%= link_to "Sign Up", new_user_registration_path, class: "btn btn-primary ms-2" %>
    </li>
  </ul>
</div>
</div>
  </nav>

  <div class="container mt-3">

  <% flash.each do |type, message| %>

    <% bootstrap_class =
      case type.to_sym
      when :notice then "alert-success"
      when :alert  then "alert-danger"
      else "alert-info"
      end
    %>

    <div class="alert <%= bootstrap_class %> alert-dismissible fade show">

      <%= message %>

      <button type="button"
              class="btn-close"
              data-bs-dismiss="alert">
      </button>

    </div>

  <% end %>

</div>

  <%= yield %>

  <!-- FOOTER -->
  <footer class="bg-dark text-white text-center py-3 mt-5">
    <div class="container">
      <p class="mb-0">EventHub by Alfonso Waugh, Francisco Langlois | Web Development Course | 2026</p>
    </div>
  </footer>


</body>