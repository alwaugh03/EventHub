<h2 class="mb-4">Change your password</h2>
<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <div class="field mb-3">
    <p><%= f.label :password, "New password", class: "form-label" %></p>
    <% if @minimum_password_length %>
      <p><em class="text-muted">(<%= @minimum_password_length %> characters minimum)</em></p>
    <% end %>
    <p><%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control" %></p>
  </div>

  <div class="field mb-3">
    <p><%= f.label :password_confirmation, "Confirm new password", class: "form-label" %></p>
    <p><%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %></p>
  </div>

  <div class="actions mb-4">
    <%= f.submit "Change my password", class: "btn btn-primary" %>
  </div>
<% end %>

<div class="mt-3">
  <%= render "devise/shared/links" %>
</div>
      
