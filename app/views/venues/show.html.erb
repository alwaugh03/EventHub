<div class="container mt-4">

  <div class="card">

    <div class="card-body">

      <h1 class="card-title mb-3">
        <%= @venue.name %>
      </h1>

      <p class="card-text">
        <strong>Address:</strong>
        <%= @venue.address %>
      </p>

      <p class="card-text">
        <strong>Capacity:</strong>
        <%= @venue.capacity %>
      </p>

    </div>

    <div class="card-footer d-flex gap-2">

      <%= link_to "Edit",
                  edit_venue_path(@venue),
                  class: "btn btn-primary" %>

      <%= link_to "Back",
                  venues_path,
                  class: "btn btn-secondary" %>

    </div>

  </div>

</div>