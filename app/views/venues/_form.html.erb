<%= form_with(model: venue, local: true) do |f| %>

  <% if venue.errors.any? %>

    <div class="alert alert-danger">

      <h5>
        <%= pluralize(venue.errors.count, "error") %>
        prevented this venue from being saved:
      </h5>

      <ul class="mb-0">
        <% venue.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>

    </div>

  <% end %>

  <div class="mb-3">

    <%= f.label :name, class: "form-label" %>

    <%= f.text_field :name,
        class: "form-control #{'is-invalid' if venue.errors[:name].any?}" %>

    <div class="invalid-feedback">
      <%= venue.errors[:name].first %>
    </div>

  </div>

  <div class="mb-3">

    <%= f.label :address, class: "form-label" %>

    <%= f.text_field :address,
        class: "form-control #{'is-invalid' if venue.errors[:address].any?}" %>

    <div class="invalid-feedback">
      <%= venue.errors[:address].first %>
    </div>

  </div>

  <div class="mb-3">

    <%= f.label :capacity, class: "form-label" %>

    <%= f.number_field :capacity,
        class: "form-control #{'is-invalid' if venue.errors[:capacity].any?}" %>

    <div class="invalid-feedback">
      <%= venue.errors[:capacity].first %>
    </div>

  </div>

  <%= f.submit class: "btn btn-primary" %>

<% end %>