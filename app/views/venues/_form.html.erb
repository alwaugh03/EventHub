<%= form_with(model: venue, local: true, data: { turbo: false }) do |f| %>

  <% if venue.errors.any? %>
    <div class="alert alert-danger">
      <h5>
        <%= pluralize(venue.errors.count, "error") %>
        prevented this venue from being saved:
      </h5>

      <ul>
        <% venue.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :address, class: "form-label" %>
    <%= f.rich_text_field :address, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :capacity, class: "form-label" %>
    <%= f.number_field :capacity,
                       class: "form-control" %>
  </div>

  <div class="mt-3">
    <%= f.submit class: "btn btn-primary" %>
  </div>

<% end %>