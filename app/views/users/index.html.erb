<h3>Users</h3>

<% if @users.any? %>
  <div class="row">
    <% @users.each do |user| %>
      <div class="col-md-4 mb-3">
        <div class="card p-3">

            <%= link_to  user_path(user), class: "nav-link" do %>
                <%= user.first_name %> <%= user.last_name %>
            <% end %>

          <p><strong>Email:</strong> <%= user.email%></p>
          <p><strong>Phone:</strong> <%= user.phone%></p>

          

        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p>No events found.</p>
<% end %>
